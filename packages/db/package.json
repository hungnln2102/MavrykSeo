{
    "name":  "@seo/db",
    "version":  "1.0.0",
    "private":  true,
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "scripts":  {
                    "build":  "tsc",
                    "typecheck":  "tsc --noEmit",
                    "dev":  "tsc -w",
                    "db:generate":  "drizzle-kit generate",
                    "db:push":  "drizzle-kit push",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:check":  "drizzle-kit check",
                    "db:seed":  "tsc && node dist/seed.js",
                    "db:validate:standards": "tsc && node dist/validate-standards.js",
                    "db:seed:standards": "tsc && node dist/seed-standards.js"
                },
    "dependencies":  {
                         "drizzle-orm":  "^0.33.0",
                         "postgres":  "^3.4.4",
                         "@seo/core":  "workspace:*"
                     },
    "devDependencies":  {
                            "drizzle-kit":  "^0.24.2",
                            "typescript":  "^5.5.4"
                        }
}
