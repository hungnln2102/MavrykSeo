NODE_ENV=development
DATABASE_URL=postgresql://seo:seo@localhost:5435/seo_platform
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=seo
CLICKHOUSE_PASSWORD=seo
CLICKHOUSE_DB=seo_platform
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Emergency system-wide crawl stop. Keep false unless an operator pauses all outbound crawls.
CRAWL_KILL_SWITCH=false
# Production requires an explicit comma-separated hostname allowlist, for example: example.com,*.example.com
CRAWLER_OUTBOUND_ALLOWLIST=
CRAWLER_CIRCUIT_FAILURE_THRESHOLD=5
CRAWLER_CIRCUIT_COOLDOWN=1m
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=seo-platform-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
BETTER_AUTH_SECRET=replace-with-a-local-development-secret
JWT_SECRET=replace-with-a-local-development-secret
GSC_TOKEN_ENCRYPTION_KEY=replace-with-a-local-development-encryption-key
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Disabled by default. The API scheduler dispatches configured site crawls through normal quota and kill-switch checks.
CRAWL_SCHEDULER_ENABLED=false
CRAWL_SCHEDULER_TICK_MS=60000
